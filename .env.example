# Next.js server only
CLOUDFLARE_API_URL=http://localhost:8787
CLOUDFLARE_APP_TOKEN=replace-with-the-worker-APP_API_TOKEN
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
TG_BOT_TOKEN=

# Public asset origin; set before building the production Next.js bundle.
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:8787

# Local Telegram import only; never configure these as NEXT_PUBLIC variables.
CLOUDFLARE_IMPORT_TOKEN=replace-with-the-worker-IMPORT_API_TOKEN
TG_API_ID=
TG_API_HASH=
TG_CHANNEL=tanya_strelchuk_blog
TG_SESSION_NAME=.telegram-session
TG_IMPORT_LIMIT=500

