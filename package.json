{
  "name": "amazing-ekb1",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "vercel-build": "pnpm build",
    "types": "tsc --noEmit",
    "cf:types": "wrangler types cloudflare/worker-configuration.d.ts --config cloudflare/wrangler.jsonc",
    "cf:check": "tsc -p cloudflare/tsconfig.json",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local --config cloudflare/wrangler.jsonc",
    "cf:build": "wrangler deploy --dry-run --outdir .wrangler/build --config cloudflare/wrangler.jsonc",
    "cf:deploy": "tsx scripts/cloudflare/assets-cli.ts verify && wrangler deploy --config cloudflare/wrangler.jsonc",
    "assets:from-repo": "tsx scripts/cloudflare/assets-cli.ts from-repo",
    "assets:hydrate": "tsx scripts/cloudflare/assets-cli.ts hydrate",
    "migration:export": "tsx scripts/cloudflare/export-supabase.ts",
    "migration:verify": "tsx scripts/cloudflare/verify-migration.ts",
    "sync:telegram": "tsx scripts/main.ts",
    "test": "pnpm cf:build && tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-aspect-ratio": "^1.1.4",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@twa-dev/sdk": "^8.0.2",
    "@twa-dev/utils": "^0.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "input": "^1.0.1",
    "jose": "^6.0.10",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.503.0",
    "motion": "^12.9.2",
    "next": "15.5.26",
    "prompts": "^2.4.2",
    "react": "^19.0.8",
    "react-dom": "^19.0.8",
    "react-hook-form": "^7.55.0",
    "server-only": "^0.0.1",
    "swiper": "^11.2.6",
    "tailwind-merge": "^3.2.0",
    "telegram": "^2.26.22",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "miniflare": "5.20260923.0-alpha",
    "pg": "^8.23.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.2.8",
    "typescript": "^5",
    "wrangler": "^4.140.0",
    "@supabase/supabase-js": "^2.49.4"
  }
}
